+def _with_provenance(name: str, arguments: dict, result: dict,
+                     *, legacy_cache: bool = False) -> dict:
+    """Attach an observation identity, not a verification verdict.
+
+    Cached observations retain their original metadata. A legacy cache or an
+    error has no known successful retrieval time: keep that value null.
+    """
+    if isinstance(result.get("_provenance"), dict):
+        return result
+    canonical_url = None
+    source_id = "tool:" + name
+    if name == "verify_release":
+        repo = str(arguments.get("repo", ""))
+        source_id = "github:" + repo.lower()
+        matched = result.get("matched_release")
+        if isinstance(matched, dict):
+            canonical_url = matched.get("url") or None
+        if canonical_url is None and "/" in repo:
+            canonical_url = "https://github.com/" + repo + "/releases"
+    elif name == "github_lookup":
+        source_id = "github:repository_search"
+        canonical_url = GITHUB_API + "/search/repositories?" + urlencode(
+            {"q": arguments.get("query", "")})
+    elif name == "search_curriculum":
+        source_id = "local:curriculum"
+        canonical_url = "local://curriculum"
+    retrieved_at = (None if legacy_cache or "error" in result else
+                    datetime.now(timezone.utc).isoformat())
+    payload = {k: v for k, v in result.items() if k != "_cache"}
+    identity = json.dumps({"tool": name, "arguments": arguments,
+                           "retrieved_at": retrieved_at, "payload": payload},
+                          sort_keys=True, default=str).encode()
+    return {**result, "_provenance": {
+        "source_id": source_id,
+        "canonical_url": canonical_url,
+        "retrieved_at": retrieved_at,
+        "tool_result_id": "sha256:" + hashlib.sha256(identity).hexdigest(),
+        "origin": ("legacy_cache" if legacy_cache else
+                   "error" if "error" in result else "tool_observation"),
+    }}
+
+
+def _tool_result(name: str):
+    """Give direct tool callers the same dict/error/provenance contract."""
+    def decorate(func):
+        @wraps(func)
+        def wrapped(*args, **kwargs):
+            arguments = {}
+            try:
+                bound = signature(func).bind(*args, **kwargs)
+                bound.apply_defaults()
+                arguments = dict(bound.arguments)
+                result = func(*args, **kwargs)
+                if not isinstance(result, dict):
+                    result = {"error": f"{name} returned a non-dict result"}
+                return _with_provenance(name, arguments, result)
+            except Exception as exc:
+                return _with_provenance(name, {}, {
+                    "error": f"{name} failed: {type(exc).__name__}"})
+        return wrapped
+    return decorate
+
+
